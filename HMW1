from browser_use_sdk import BrowserUse
client = BrowserUse(api_key="your_api_key_here")
steps = [
    "Open https://en.wikipedia.org/wiki/Engineering_mechanics",
    "Scroll down and click on the 'Statics' section",
    "Follow the link to 'Newton's laws of motion'",
    "Go to the 'Equilibrium' subsection",
    "Click on the 'Rigid body' link",
    "Finally, follow the link to 'Force (physics)'"
]
task = "\n".join(f"{i+1}. {step}" for i, step in enumerate(steps))
result = client.tasks.run(task=task)
print("=== Task Execution Summary ===")
print(result.done_output)


