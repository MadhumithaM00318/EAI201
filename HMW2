def grade(marks):
    if marks >= 90:
        return "A+"
    elif marks >= 75:
        return "A"
    elif marks >= 60:
        return "B"
    elif marks >= 40:
        return "C"
    else:
        return "F"

def student_grading():
    n = int(input("How many subjects? "))
    results = {}

    for i in range(n):
        subject = input(f"Enter subject {i+1}: ")
        marks = int(input(f"Enter marks in {subject}: "))
        results[subject] = grade(marks)

    print("\n--- Report Card ---")
    for subject, g in results.items():
        print(f"{subject}: {g}")

student_grading()

