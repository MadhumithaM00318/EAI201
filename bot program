from collections import deque


faq_data = {
    "library timings": "The library is open from 9 AM to 9 PM.",
    "food court timings": "The food court is open from 8 AM to 9 PM.",
    "sports complex timings": "The sports complex is open from 6 AM to 8 AM and 4:30 PM to 7 PM."
}


campus_locations = {
    "Main Gate": ["Admin Block"],
    "Admin Block": ["Library (inside Admin)", "Engineering Block"],
    "Library (inside Admin)": [],
    "Engineering Block": ["Food Court"],
    "Food Court": ["Football Court", "Hostel Block 1"],
    "Football Court": [],
    "Hostel Block 1": ["Sports Road"],
    "Sports Road": ["Cricket Ground", "Basketball Court", "Volleyball Court"],
    "Cricket Ground": [],
    "Basketball Court": [],
    "Volleyball Court": []
}


def find_shortest_path(graph, start, destination):
    visited = set()
    queue = deque([[start]])   

    while queue:
        current_path = queue.popleft()
        current_place = current_path[-1]

        if current_place == destination:
            return current_path 

        if current_place not in visited:
            for neighbor in graph.get(current_place, []):
                new_path = list(current_path)
                new_path.append(neighbor)
                queue.append(new_path)

            visited.add(current_place)

    return None  


def chatbot_reply(user_message):
    message = user_message.lower()

   
    if message in ["hi", "hello", "hey"]:
        return "Hello!  How can I help you today?"

   
    for key in faq_data:
        if key in message:
            return faq_data[key]

   
    places_found = [place for place in campus_locations if place.lower() in message]

    
    if len(places_found) >= 2:
        path = find_shortest_path(campus_locations, places_found[0], places_found[1])
        if path:
            return "Shortest path: " + " ➝ ".join(path)
        else:
            return "Sorry, I couldn’t find a path between those locations."

    return "I’m not sure about that . Try asking about timings or directions between two places."


if __name__ == "__main__":
    print(" Campus Chatbot Ready! (type 'exit' to quit)\n")
    while True:
        user_input = input("You: ")
        if user_input.lower() == "exit":
            print("Chatbot: Goodbye!")
            break
        response = chatbot_reply(user_input)
        print("Chatbot:", response)
